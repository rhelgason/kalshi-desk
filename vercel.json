{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/tick.py": {
      "maxDuration": 120,
      "memory": 1024,
      "includeFiles": "{desk/**,desk.yaml}",
      "excludeFiles": "{web/**,tests/**,data/**,deploy/**,core/**,polymarket_client/**,kalshi_client/**,dashboard/**,utils/**,**/*.mp4,**/*.png}"
    }
  },
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/tick"
    }
  ]
}
