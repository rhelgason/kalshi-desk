[Unit]
Description=Kalshi Desk paper trader
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/kalshi-desk.env
ExecStart=__APP_DIR__/.venv/bin/python -u -m desk paper
Restart=always
RestartSec=10
# Keep memory in check on a 1 GB VM
MemoryMax=600M

[Install]
WantedBy=multi-user.target
